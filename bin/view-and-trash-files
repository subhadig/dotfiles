#!/usr/bin/env bash

TRASH_BIN=$HOME/workspaces/personal/dotfiles/bin/trash

if command -v open 1>/dev/null 2>&1; then
    OPEN='open'
else
    OPEN='xdg-open'
fi

IFS_ORIG=$IFS
IFS=$'\n'
echo Enter \'q\' to quit anytime.
for file in `ls -1tp | grep -v '/'`;do
    while :
    do
        read -p "Open[o]/Trash[t]/Skip[s] file: $file? " choice
        case "$choice" in
            o)
                $OPEN "$file" 2>/dev/null
                ;;
            t)
                $TRASH_BIN "$file"
                break
                ;;
            s)
                continue 2
                ;;
            q)
                break 2
                ;;
        esac
    done
done
IFS=$IFS_ORIG
